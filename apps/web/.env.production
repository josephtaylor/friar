# Loaded automatically by `vite build` (production mode). Keeps prod URLs out of the
# build command so they can't be forgotten (a missing VITE_INDEXER_URL silently fell
# back to localhost, so the eager ingest never ran in prod → new positions "vanished").
VITE_API_URL=https://api.friar.fi
VITE_INDEXER_URL=https://indexer.friar.fi
